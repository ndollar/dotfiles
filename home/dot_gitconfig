[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[delta]
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
