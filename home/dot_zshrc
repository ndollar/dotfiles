# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git zsh-syntax-highlighting fzf)

source $ZSH/oh-my-zsh.sh

[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

export PATH="$(go env GOPATH)/bin:$PATH"

export PATH="$HOME/.asdf/shims:$PATH"

[ -s "$HOME/.docker/init-zsh.sh" ] && source "$HOME/.docker/init-zsh.sh"

[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

alias local-ports='for p in 3000 3001 3002; do echo -n "Port $p: "; pid=$(lsof -iTCP:$p -sTCP:LISTEN -t 2>/dev/null); if [ -n "$pid" ]; then cwd=$(lsof -p $pid -a -d cwd -Fn 2>/dev/null | awk "/^n/ {print substr(\$0,2)}"); echo "taken (PID $pid) $cwd"; else echo "available"; fi; done'

alias repo-status='for dir in ~/code/*/ ~/code/*/*/; do if [ -d "$dir/.git" ]; then branch=$(git -C "$dir" branch --show-current 2>/dev/null); relpath=${dir#$HOME/code/}; changes=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d " "); if [ "$changes" -gt 0 ]; then dirty="*$changes"; else dirty=""; fi; printf "%-40s %-20s %s\n" "${relpath%/}" "$branch" "$dirty"; fi; done'

setopt extended_glob
alias gdh="git diff HEAD~1"
